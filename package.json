{
  "name": "syntaxx.lol-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "syntaxx.lol — the Syntaxx Discord bot's website and dashboard, on Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --build --force",
    "verify": "node scripts/verify.js",
    "deploy": "npm run build && wrangler deploy",
    "browser-check": "node scripts/browser-check.js"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "wouter": "^3.10.0",
    "wrangler": "~4.86.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
